# -----------------------------------------------------------------------------
# QuickCart - native Windows development stack configuration
#
# Copy to devstack/.env (done automatically by `qc install-stack`).
# devstack/.env is git-ignored: empty *_PASSWORD values are replaced with
# random secrets on first run and must never be committed.
# Use KEY=VALUE lines only (no inline comments).
# -----------------------------------------------------------------------------

# Where binaries, data and logs live. Must NOT contain spaces.
STACK_DIR=E:/quickcart-stack

# --- Component versions ------------------------------------------------------
MAGENTO_VERSION=2.4.9
PHP_VERSION=8.4.27
PHP_SHA256=93bd8a815a52156606fb906d0573437908c61f96e2cc52c03a51e36a41bf5236
COMPOSER_VERSION=2.11.2
MYSQL_VERSION=8.4.13
OPENSEARCH_VERSION=3.9.0
NGINX_VERSION=1.30.6

# --- Magento Composer repository -----------------------------------------------
# https://mirror.mage-os.org/ : public mirror of the Magento Open Source packages (no keys)
# https://repo.magento.com/   : Adobe repository (needs src/auth.json with Marketplace keys)
MAGENTO_COMPOSER_REPO=https://mirror.mage-os.org/

# --- Web server ----------------------------------------------------------------
# *.localhost resolves to 127.0.0.1 in Chrome/Edge/Firefox without editing the hosts file.
SERVER_NAME=quickcart.localhost
HTTP_PORT=8080
BASE_URL=http://quickcart.localhost:8080/
PHP_CGI_PORTS=9071,9072,9073

# --- MySQL 8.4 -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=quickcart
DB_USER=quickcart
DB_PASSWORD=
DB_ROOT_PASSWORD=
MYSQL_BUFFER_POOL=256M

# --- OpenSearch 3 --------------------------------------------------------------
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_PORT=9200
OPENSEARCH_HEAP=1g
OPENSEARCH_INDEX_PREFIX=quickcart

# --- Magento store & admin -------------------------------------------------------
ADMIN_FRONTNAME=qc_admin
ADMIN_USER=qcadmin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_FIRSTNAME=QuickCart
ADMIN_LASTNAME=Admin
LANGUAGE=en_US
CURRENCY=INR
TIMEZONE=Asia/Kolkata
