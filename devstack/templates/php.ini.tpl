; -----------------------------------------------------------------------------
; QuickCart - PHP {{PHP_VERSION}} configuration for Magento {{MAGENTO_VERSION}} (generated by
; devstack/qc install-stack from devstack/templates/php.ini.tpl - edit the template).
; Values follow the Adobe Commerce "Required PHP settings" guidance.
; -----------------------------------------------------------------------------
[PHP]
engine = On
short_open_tag = Off
precision = 14
serialize_precision = -1
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
expose_php = Off
zend.enable_gc = On

max_execution_time = 1800
max_input_time = 600
max_input_vars = 10000
memory_limit = 4G

error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
error_log = "{{LOG_DIR}}/php_errors.log"

variables_order = "GPCS"
request_order = "GP"
register_argc_argv = Off
auto_globals_jit = On
default_charset = "UTF-8"

post_max_size = 64M
file_uploads = On
upload_max_filesize = 64M
max_file_uploads = 20
upload_tmp_dir = "{{TMP_DIR}}"
sys_temp_dir = "{{TMP_DIR}}"

allow_url_fopen = On
allow_url_include = Off
default_socket_timeout = 60
enable_dl = Off
cgi.fix_pathinfo = 1

realpath_cache_size = 10M
realpath_cache_ttl = 7200

extension_dir = "{{PHP_DIR}}/ext"

; Extensions required by magento/framework and magento/product-community-edition
{{PHP_EXTENSIONS}}

[Date]
date.timezone = UTC

[Session]
session.save_handler = files
session.auto_start = 0
session.use_cookies = 1
session.use_only_cookies = 1
session.cookie_httponly = 1
session.gc_maxlifetime = 86400

[Assertion]
zend.assertions = -1

[curl]
curl.cainfo = "{{CACERT}}"

[openssl]
openssl.cafile = "{{CACERT}}"

[opcache]
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 512
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 100000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 2
opcache.save_comments = 1
