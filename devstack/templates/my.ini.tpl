# -----------------------------------------------------------------------------
# QuickCart - MySQL {{MYSQL_VERSION}} server configuration (generated by devstack/qc
# install-stack from devstack/templates/my.ini.tpl - edit the template).
# -----------------------------------------------------------------------------
[mysqld]
basedir="{{MYSQL_DIR}}"
datadir="{{MYSQL_DATA_DIR}}"
port={{DB_PORT}}
bind-address=127.0.0.1
mysqlx=OFF
log-error="{{LOG_DIR}}/mysql-error.log"

character-set-server=utf8mb4
collation-server=utf8mb4_general_ci
default-time-zone='+00:00'
explicit_defaults_for_timestamp=ON

# Binary logging is not needed locally; disabling it also lets the Magento DB user
# create triggers (used by the mview / "Update by Schedule" indexers) without SUPER.
skip-log-bin

innodb_buffer_pool_size={{MYSQL_BUFFER_POOL}}
innodb_log_buffer_size=16M
innodb_flush_log_at_trx_commit=2
innodb_file_per_table=ON
max_allowed_packet=64M
max_connections=150
tmp_table_size=64M
max_heap_table_size=64M

[client]
port={{DB_PORT}}
default-character-set=utf8mb4
