# -----------------------------------------------------------------------------
# QuickCart - OpenSearch {{OPENSEARCH_VERSION}} single-node development cluster
# (generated by devstack/qc install-stack from devstack/templates/opensearch.yml.tpl).
# -----------------------------------------------------------------------------
cluster.name: quickcart-dev
node.name: quickcart-node-1

path.data: "{{OPENSEARCH_DATA_DIR}}"
path.logs: "{{LOG_DIR}}/opensearch"

network.host: 127.0.0.1
http.port: {{OPENSEARCH_PORT}}
discovery.type: single-node
bootstrap.memory_lock: false

# Local development only: the node is bound to loopback, so TLS/auth is disabled.
# Production clusters must enable the security plugin and Magento's
# "OpenSearch HTTP Auth" settings (catalog/search/opensearch_enable_auth).
plugins.security.disabled: true

cluster.routing.allocation.disk.threshold_enabled: false
action.destructive_requires_name: true
