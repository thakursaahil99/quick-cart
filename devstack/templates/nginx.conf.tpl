# -----------------------------------------------------------------------------
# QuickCart - Nginx {{NGINX_VERSION}} (generated by devstack/qc install-stack from
# devstack/templates/nginx.conf.tpl - edit the template).
#
# The Magento-specific locations come from Magento's own nginx.conf.sample, which
# composer deploys into src/ - so the rules always match the installed version.
# -----------------------------------------------------------------------------
worker_processes  1;
error_log  "{{LOG_DIR}}/nginx-error.log" warn;
pid        logs/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    access_log  "{{LOG_DIR}}/nginx-access.log";
    sendfile    off;
    keepalive_timeout  65;
    server_tokens off;
    client_max_body_size 64m;

    fastcgi_read_timeout 1800s;
    fastcgi_send_timeout 1800s;
    fastcgi_next_upstream error timeout invalid_header;
    fastcgi_next_upstream_tries 3;

    # php-cgi workers started by `qc start` (one per port, supervised).
    upstream fastcgi_backend {
{{PHP_UPSTREAMS}}
    }

    server {
        listen       127.0.0.1:{{HTTP_PORT}};
        listen       [::1]:{{HTTP_PORT}};
        server_name  {{SERVER_NAME}} localhost 127.0.0.1;

        # `qc share` publishes the storefront through a Cloudflare tunnel. Requests that
        # arrive through Cloudflare carry a Cf-Ray header: they never reach the admin,
        # the setup tools or the admin token API (admin stays on this machine only).
        set $qc_via_tunnel "";
        if ($http_cf_ray) {
            set $qc_via_tunnel "1";
        }
        set $qc_private "";
        if ($request_uri ~* "^/(index\.php/)?({{ADMIN_FRONTNAME}}|admin|setup|update)(/|\?|$)") {
            set $qc_private "1";
        }
        if ($request_uri ~* "^/(index\.php/)?rest/([^/]+/)?V1/integration/admin/") {
            set $qc_private "1";
        }
        set $qc_block "$qc_via_tunnel$qc_private";
        if ($qc_block = "11") {
            return 403;
        }

        set $MAGE_ROOT "{{MAGE_ROOT}}";
        include "{{MAGE_ROOT}}/nginx.conf.sample";
    }
}
