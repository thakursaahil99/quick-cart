<?xml version="1.0"?>
<!--
/**
 * QuickCart_ProductRecommendation
 *
 * Product recommendations stored in quickcart_product_recommendation:
 *  - "Frequently bought together" mined from real order history (co-purchases),
 *  - "Similar products" scored from catalog data (categories, brand, price band),
 *  - manual recommendations managed in Admin > QuickCart > Recommendations.
 * Rebuilt nightly by cron, from the CLI or from the admin grid. Also renders a
 * localStorage-based "Recently viewed" rail that works with the full-page cache.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="QuickCart_ProductRecommendation">
        <sequence>
            <module name="Magento_Catalog"/>
            <module name="Magento_Checkout"/>
            <module name="Magento_Cron"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Ui"/>
            <module name="QuickCart_Core"/>
            <module name="QuickCart_CatalogEnhancement"/>
        </sequence>
    </module>
</config>
