<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        One row = "when a shopper looks at product_id, recommend recommended_product_id".
        source: orders (co-purchase mining), catalog (similarity scoring) or manual (admin).
        Automatic rows are replaced on every rebuild; manual rows are never touched by it.
        Both product columns cascade, so deleting a product removes its recommendations.
    -->
    <table name="quickcart_product_recommendation" resource="default" engine="innodb"
           comment="QuickCart product recommendations">
        <column xsi:type="int" name="recommendation_id" unsigned="true" nullable="false" identity="true"
                comment="Recommendation ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Viewed Product ID"/>
        <column xsi:type="int" name="recommended_product_id" unsigned="true" nullable="false"
                comment="Recommended Product ID"/>
        <column xsi:type="varchar" name="type" nullable="false" length="32" default="bought_together"
                comment="Type (bought_together, similar)"/>
        <column xsi:type="varchar" name="source" nullable="false" length="16" default="manual"
                comment="Source (orders, catalog, manual)"/>
        <column xsi:type="decimal" name="score" scale="4" precision="12" unsigned="false" nullable="false"
                default="0" comment="Score (co-purchase orders or similarity)"/>
        <column xsi:type="int" name="position" unsigned="false" nullable="false" default="0"
                comment="Manual Position"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1"
                comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="recommendation_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="QUICKCART_PRD_RECOMMENDATION_PRD_ID_RECOMMENDED_PRD_ID_TYPE">
            <column name="product_id"/>
            <column name="recommended_product_id"/>
            <column name="type"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="QUICKCART_PRD_RECOMMENDATION_PRD_ID_CAT_PRD_ENTT_ENTT_ID"
                    table="quickcart_product_recommendation" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="QC_PRD_RECOMMENDATION_RECOMMENDED_PRD_ID_CAT_PRD_ENTT_ENTT_ID"
                    table="quickcart_product_recommendation" column="recommended_product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="QUICKCART_PRODUCT_RECOMMENDATION_PRODUCT_ID_TYPE_IS_ACTIVE" indexType="btree">
            <column name="product_id"/>
            <column name="type"/>
            <column name="is_active"/>
        </index>
        <index referenceId="QUICKCART_PRODUCT_RECOMMENDATION_SOURCE" indexType="btree">
            <column name="source"/>
        </index>
    </table>
</schema>
