<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Badges + brand for product cards; themes read it with $block->getData('qc_badges'). -->
        <referenceBlock name="category.products.list">
            <arguments>
                <argument name="qc_badges" xsi:type="object">QuickCart\CatalogEnhancement\ViewModel\ProductBadges</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
