<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="quickcart_catalog" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1"
                 showInStore="1">
            <class>separator-top</class>
            <label>Catalog &amp; Labels</label>
            <tab>quickcart</tab>
            <resource>QuickCart_CatalogEnhancement::config</resource>
            <group id="labels" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>Product Labels</label>
                <comment>Label rules are managed in QuickCart &gt; Catalog &gt; Product Labels.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show Labels on the Storefront</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="max_per_card" translate="label comment" type="text" sortOrder="20" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Maximum Labels per Product</label>
                    <comment>1 to 4. Labels are picked in priority order.</comment>
                    <validate>required-entry validate-digits validate-digits-range digits-range-1-4</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
