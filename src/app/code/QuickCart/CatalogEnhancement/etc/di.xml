<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Merchandising sources for the product carousel widget. Other modules can add items. -->
    <type name="QuickCart\CatalogEnhancement\Model\ProductSource\SourcePool">
        <arguments>
            <argument name="sources" xsi:type="array">
                <item name="trending" xsi:type="object">QuickCart\CatalogEnhancement\Model\ProductSource\TrendingSource</item>
                <item name="new" xsi:type="object">QuickCart\CatalogEnhancement\Model\ProductSource\NewArrivalsSource</item>
                <item name="deals" xsi:type="object">QuickCart\CatalogEnhancement\Model\ProductSource\DealsSource</item>
                <item name="bestsellers" xsi:type="object">QuickCart\CatalogEnhancement\Model\ProductSource\BestsellersSource</item>
            </argument>
        </arguments>
    </type>

    <!-- Product label rules -->
    <preference for="QuickCart\CatalogEnhancement\Api\Data\LabelInterface"
                type="QuickCart\CatalogEnhancement\Model\Label"/>
    <preference for="QuickCart\CatalogEnhancement\Api\Data\LabelSearchResultsInterface"
                type="Magento\Framework\Api\SearchResults"/>
    <preference for="QuickCart\CatalogEnhancement\Api\LabelRepositoryInterface"
                type="QuickCart\CatalogEnhancement\Model\LabelRepository"/>

    <!-- Admin grid data source -->
    <type name="QuickCart\CatalogEnhancement\Model\ResourceModel\Label\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">quickcart_product_label</argument>
            <argument name="resourceModel" xsi:type="string">QuickCart\CatalogEnhancement\Model\ResourceModel\Label</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="quickcart_product_label_listing_data_source" xsi:type="string">QuickCart\CatalogEnhancement\Model\ResourceModel\Label\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
