<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="QuickCart_Core::quickcart">
                    <resource id="QuickCart_CatalogEnhancement::product_labels" title="Product Labels" translate="title"
                              sortOrder="10">
                        <resource id="QuickCart_CatalogEnhancement::product_labels_save" title="Create / Edit"
                                  translate="title" sortOrder="10"/>
                        <resource id="QuickCart_CatalogEnhancement::product_labels_delete" title="Delete"
                                  translate="title" sortOrder="20"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="QuickCart_Core::config">
                                <resource id="QuickCart_CatalogEnhancement::config" title="Catalog &amp; Labels"
                                          translate="title" sortOrder="10"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
