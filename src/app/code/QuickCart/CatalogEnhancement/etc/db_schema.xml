<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        Product label rules managed in Admin > QuickCart > Product Labels.
        A rule says WHICH products get a label (condition_type + condition_value)
        and HOW it looks (text, colours). Matching happens at render time against
        real catalog data, so no per-product rows are stored.
    -->
    <table name="quickcart_product_label" resource="default" engine="innodb"
           comment="QuickCart product label rules">
        <column xsi:type="int" name="label_id" unsigned="true" nullable="false" identity="true" comment="Label ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="120" comment="Admin Name"/>
        <column xsi:type="varchar" name="text" nullable="false" length="40" comment="Storefront Text"/>
        <column xsi:type="varchar" name="condition_type" nullable="false" length="20" default="sku"
                comment="Condition Type (sku, category, sale, new, trending)"/>
        <column xsi:type="text" name="condition_value" nullable="true" comment="Condition Value"/>
        <column xsi:type="varchar" name="background_color" nullable="false" length="7" default="#2563EB"
                comment="Background Colour (hex)"/>
        <column xsi:type="varchar" name="text_color" nullable="false" length="7" default="#FFFFFF"
                comment="Text Colour (hex)"/>
        <column xsi:type="int" name="sort_order" unsigned="false" nullable="false" default="0" comment="Priority"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="date" name="from_date" nullable="true" comment="Active From"/>
        <column xsi:type="date" name="to_date" nullable="true" comment="Active To"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="label_id"/>
        </constraint>
        <index referenceId="QUICKCART_PRODUCT_LABEL_IS_ACTIVE_SORT_ORDER" indexType="btree">
            <column name="is_active"/>
            <column name="sort_order"/>
        </index>
        <index referenceId="QUICKCART_PRODUCT_LABEL_NAME_TEXT" indexType="fulltext">
            <column name="name"/>
            <column name="text"/>
        </index>
    </table>

    <!-- Store views a label applies to (store_id 0 = all store views). -->
    <table name="quickcart_product_label_store" resource="default" engine="innodb"
           comment="QuickCart product label to store view">
        <column xsi:type="int" name="label_id" unsigned="true" nullable="false" comment="Label ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="label_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="QUICKCART_PRD_LBL_STORE_LBL_ID_QUICKCART_PRD_LBL_LBL_ID"
                    table="quickcart_product_label_store" column="label_id" referenceTable="quickcart_product_label"
                    referenceColumn="label_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="QUICKCART_PRODUCT_LABEL_STORE_STORE_ID_STORE_STORE_ID"
                    table="quickcart_product_label_store" column="store_id" referenceTable="store"
                    referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="QUICKCART_PRODUCT_LABEL_STORE_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
    </table>
</schema>
