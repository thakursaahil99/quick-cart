<?xml version="1.0"?>
<!--
/**
 * QuickCart_DemoData
 *
 * Installs the QuickCart demo store through data patches: attribute options and
 * colour swatches, the category tree, 48 electronics products (incl. configurable
 * products), homepage CMS content, shipping/payment settings and the theme.
 * Fixtures live in fixtures/ and are generated by tools/design-assets.
 * `bin/magento quickcart:demo:orders` adds a realistic order history (real orders,
 * invoices, shipments and cancellations) for the dashboard, reports and recommendations.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="QuickCart_DemoData">
        <sequence>
            <module name="QuickCart_CatalogEnhancement"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_ConfigurableProduct"/>
            <module name="Magento_Swatches"/>
            <module name="Magento_Cms"/>
            <module name="Magento_Theme"/>
            <module name="Magento_OfflineShipping"/>
            <module name="Magento_OfflinePayments"/>
            <module name="Magento_CatalogInventory"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
            <module name="QuickCart_OrderTracking"/>
            <module name="QuickCart_ProductRecommendation"/>
            <module name="QuickCart_SalesDashboard"/>
        </sequence>
    </module>
</config>
