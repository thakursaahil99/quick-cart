<?xml version="1.0"?>
<!--
/**
 * QuickCart_SalesDashboard
 *
 * Admin sales analytics: a dashboard (KPIs with period-over-period change, revenue and
 * order trends, status mix, top products, payment methods, recent orders, monthly
 * target progress), date-wise sales and best-seller reports with CSV export, and
 * monthly sales targets (quickcart_sales_target, admin CRUD grid).
 * Figures are queried live from the sales tables, so they are always current.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="QuickCart_SalesDashboard">
        <sequence>
            <module name="Magento_Backend"/>
            <module name="Magento_Payment"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Ui"/>
            <module name="QuickCart_Core"/>
        </sequence>
    </module>
</config>
