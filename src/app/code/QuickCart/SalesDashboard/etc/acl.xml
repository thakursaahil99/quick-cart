<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="QuickCart_Core::quickcart">
                    <resource id="QuickCart_SalesDashboard::analytics" title="Sales Analytics" translate="title"
                              sortOrder="5">
                        <resource id="QuickCart_SalesDashboard::dashboard" title="Sales Dashboard" translate="title"
                                  sortOrder="10"/>
                        <resource id="QuickCart_SalesDashboard::reports" title="Sales Reports (view &amp; export)"
                                  translate="title" sortOrder="20"/>
                        <resource id="QuickCart_SalesDashboard::targets" title="Sales Targets" translate="title"
                                  sortOrder="30">
                            <resource id="QuickCart_SalesDashboard::targets_save" title="Create / Edit"
                                      translate="title" sortOrder="10"/>
                            <resource id="QuickCart_SalesDashboard::targets_delete" title="Delete"
                                      translate="title" sortOrder="20"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="QuickCart_Core::config">
                                <resource id="QuickCart_SalesDashboard::config" title="Sales Dashboard"
                                          translate="title" sortOrder="50"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
