$deltaHtml = static function (?array $delta, string $compare) use ($escaper): string {
    if (!$delta) {
        return '<span class="qc-delta qc-delta--neutral">' . $escaper->escapeHtml(__('No earlier data')) . '</span>';
    }
    $arrow = ['up' => '▲', 'down' => '▼', 'flat' => '■'][$delta['direction']];

    return sprintf(
        '<span class="qc-delta qc-delta--%s"><span aria-hidden="true">%s</span> %s <span class="qc-delta__vs">%s</span></span>',
        $escaper->escapeHtmlAttr($delta['tone']),
        $arrow,
        $escaper->escapeHtml($delta['text']),
        $escaper->escapeHtml($compare)
    );
};
?>
