<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="QuickCart\OrderTracking\Api\Data\TrackingEventInterface"
                type="QuickCart\OrderTracking\Model\TrackingEvent"/>
    <preference for="QuickCart\OrderTracking\Api\TrackingEventRepositoryInterface"
                type="QuickCart\OrderTracking\Model\TrackingEventRepository"/>

    <type name="QuickCart\OrderTracking\Model\TrackingSession">
        <arguments>
            <argument name="session" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <!-- Admin grid data source -->
    <type name="QuickCart\OrderTracking\Model\ResourceModel\TrackingEvent\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">quickcart_order_tracking_event</argument>
            <argument name="resourceModel" xsi:type="string">QuickCart\OrderTracking\Model\ResourceModel\TrackingEvent</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="quickcart_order_tracking_event_listing_data_source" xsi:type="string">QuickCart\OrderTracking\Model\ResourceModel\TrackingEvent\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
