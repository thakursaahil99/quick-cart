<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="quickcart_tracking_order_status" instance="QuickCart\OrderTracking\Observer\RecordOrderStatus"/>
    </event>
    <event name="sales_order_shipment_save_after">
        <observer name="quickcart_tracking_shipment" instance="QuickCart\OrderTracking\Observer\RecordShipment"/>
    </event>
    <event name="sales_order_shipment_track_save_after">
        <observer name="quickcart_tracking_shipment_track"
                  instance="QuickCart\OrderTracking\Observer\RecordShipmentTrack"/>
    </event>
</config>
