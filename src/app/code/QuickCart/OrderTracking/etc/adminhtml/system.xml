<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="quickcart_tracking" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1"
                 showInStore="1">
            <label>Order Tracking</label>
            <tab>quickcart</tab>
            <resource>QuickCart_OrderTracking::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>Tracking Page &amp; Timeline</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Order Tracking</label>
                    <comment>Tracking page at /track, footer link and the timeline on customers' order pages.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="eta_min_days" translate="label comment" type="text" sortOrder="20" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Earliest Delivery (business days)</label>
                    <comment>Counted from the order date; Sundays are skipped.</comment>
                    <validate>required-entry validate-digits validate-digits-range digits-range-0-30</validate>
                </field>
                <field id="eta_max_days" translate="label" type="text" sortOrder="30" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Latest Delivery (business days)</label>
                    <validate>required-entry validate-digits validate-digits-range digits-range-0-30</validate>
                </field>
                <field id="max_attempts" translate="label comment" type="text" sortOrder="40" showInDefault="1"
                       canRestore="1">
                    <label>Failed Lookups Allowed (per 15 minutes)</label>
                    <comment>Slows down guessing of order numbers on the public tracking form.</comment>
                    <validate>required-entry validate-digits validate-digits-range digits-range-3-50</validate>
                </field>
            </group>
        </section>
    </system>
</config>
