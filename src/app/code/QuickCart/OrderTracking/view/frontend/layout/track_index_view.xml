<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <!-- Per-visitor content: never stored in the full-page cache. -->
            <block class="QuickCart\OrderTracking\Block\TrackedOrder" name="qc.track.order" cacheable="false"
                   template="QuickCart_OrderTracking::track/order.phtml">
                <block class="QuickCart\OrderTracking\Block\TrackedOrder" name="qc.track.timeline"
                       template="QuickCart_OrderTracking::track/timeline.phtml">
                    <arguments>
                        <argument name="timeline" xsi:type="object">QuickCart\OrderTracking\ViewModel\Timeline</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
