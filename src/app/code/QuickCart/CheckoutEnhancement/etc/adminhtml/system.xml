<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="quickcart_checkout" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1"
                 showInStore="1">
            <label>Checkout</label>
            <tab>quickcart</tab>
            <resource>QuickCart_CheckoutEnhancement::config</resource>
            <group id="fields" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>Delivery Details Fields</label>
                <field id="delivery_note" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Delivery Instructions</label>
                    <comment>Optional note for the courier (max 250 characters), shown on the order in admin.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="gstin" translate="label comment" type="select" sortOrder="20" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>GSTIN for Business Invoices</label>
                    <comment>Optional 15-character GSTIN, validated in the browser and on the server.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="validation" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>Address Validation</label>
                <field id="indian_address" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Indian Mobile Number &amp; PIN Code Rules</label>
                    <comment>10-digit mobile numbers starting 6-9 and 6-digit PIN codes, for addresses in India.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="cart" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cart</label>
                <field id="free_delivery_meter" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Free-delivery Progress Meter</label>
                    <comment>Uses the threshold of Sales &gt; Delivery Methods &gt; Free Shipping.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
