<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="quickcart_checkout_fields"
                type="QuickCart\CheckoutEnhancement\Plugin\Checkout\AddCheckoutFields"/>
    </type>

    <type name="Magento\Checkout\CustomerData\Cart">
        <plugin name="quickcart_free_delivery_progress"
                type="QuickCart\CheckoutEnhancement\Plugin\CustomerData\AddFreeDeliveryProgress"/>
    </type>
    <type name="QuickCart\CheckoutEnhancement\Plugin\CustomerData\AddFreeDeliveryProgress">
        <arguments>
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
        </arguments>
    </type>
</config>
