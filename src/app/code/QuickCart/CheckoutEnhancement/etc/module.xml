<?xml version="1.0"?>
<!--
/**
 * QuickCart_CheckoutEnhancement
 *
 * Delivery instructions + GSTIN captured at checkout (own table, repository, order
 * extension attributes), Indian phone / PIN code / GSTIN validation (client and
 * server side) and the free-delivery progress meter in the mini cart and cart.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="QuickCart_CheckoutEnhancement">
        <sequence>
            <module name="Magento_Checkout"/>
            <module name="Magento_Quote"/>
            <module name="Magento_Sales"/>
            <module name="Magento_OfflineShipping"/>
            <module name="QuickCart_Core"/>
        </sequence>
    </module>
</config>
