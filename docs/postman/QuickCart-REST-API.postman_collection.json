{
    "info": {
        "name": "QuickCart REST API",
        "description": "QuickCart_CustomApi endpoints (/V1/quickcart/...) plus the Magento token calls they need.\n\n1. Set the collection variables (baseUrl, credentials).\n2. Run \"Auth / Admin token\" and/or \"Auth / Customer token\": the token is stored in adminToken / customerToken automatically.\n3. Call any endpoint. Anonymous endpoints need no token.\n\nErrors use Magento's REST format: {\"message\": \"... %1 ...\", \"parameters\": [...]}. Status codes: 400 invalid input, 401 missing/insufficient token, 404 not found, 429 too many guest tracking attempts.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://quickcart.localhost:8080/rest/default/V1", "description": "Store-scoped REST root: /rest/{store_code}/V1" },
        { "key": "adminUsername", "value": "qcadmin" },
        { "key": "adminPassword", "value": "change-me" },
        { "key": "customerEmail", "value": "meera.demo@example.com" },
        { "key": "customerPassword", "value": "change-me" },
        { "key": "adminToken", "value": "" },
        { "key": "customerToken", "value": "" },
        { "key": "sku", "value": "QC-PH-EDGE5PRO" },
        { "key": "categoryId", "value": "19" },
        { "key": "orderNumber", "value": "000000003" },
        { "key": "orderId", "value": "3" },
        { "key": "customerId", "value": "1" }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Admin token",
                    "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                        "if (pm.response.code === 200) { pm.collectionVariables.set('adminToken', pm.response.json()); }"
                    ] } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}" },
                        "url": "{{baseUrl}}/integration/admin/token",
                        "description": "Magento admin token (4 h by default). Only reachable from the server itself while the store is shared publicly."
                    }
                },
                {
                    "name": "Customer token",
                    "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                        "if (pm.response.code === 200) { pm.collectionVariables.set('customerToken', pm.response.json()); }"
                    ] } }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n    \"username\": \"{{customerEmail}}\",\n    \"password\": \"{{customerPassword}}\"\n}" },
                        "url": "{{baseUrl}}/integration/customer/token"
                    }
                }
            ]
        },
        {
            "name": "Products (anonymous)",
            "item": [
                {
                    "name": "List products",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/quickcart/products?categoryId=&brand=&priceFrom=&priceTo=&search=&sortBy=price&sortDir=asc&page=1&pageSize=12",
                            "host": ["{{baseUrl}}"],
                            "path": ["quickcart", "products"],
                            "query": [
                                { "key": "categoryId", "value": "", "description": "Optional; anchor categories include sub-categories", "disabled": true },
                                { "key": "brand", "value": "Voltix", "description": "Optional; brand name or option ID", "disabled": true },
                                { "key": "priceFrom", "value": "", "disabled": true },
                                { "key": "priceTo", "value": "5000", "disabled": true },
                                { "key": "search", "value": "pro", "description": "Name or SKU contains", "disabled": true },
                                { "key": "sortBy", "value": "price", "description": "position (in a category), name, price, newest" },
                                { "key": "sortDir", "value": "asc", "description": "asc or desc" },
                                { "key": "page", "value": "1" },
                                { "key": "pageSize", "value": "12", "description": "1-48" }
                            ]
                        },
                        "description": "Product cards: prices, discount %, QuickCart labels, brand, rating, stock, image and URL."
                    }
                },
                {
                    "name": "Product detail",
                    "request": { "method": "GET", "url": "{{baseUrl}}/quickcart/products/{{sku}}", "description": "Card + descriptions, specifications, gallery, configurable options, category IDs, related / up-sell SKUs." }
                },
                {
                    "name": "Product recommendations",
                    "request": { "method": "GET", "url": "{{baseUrl}}/quickcart/products/{{sku}}/recommendations", "description": "Frequently bought together (salable companions) and similar products." }
                }
            ]
        },
        {
            "name": "Categories (anonymous)",
            "item": [
                {
                    "name": "Category tree",
                    "request": { "method": "GET", "url": "{{baseUrl}}/quickcart/categories?depth=2", "description": "Active categories with URL, image and visible product count (from the category index)." }
                },
                {
                    "name": "Category products",
                    "request": { "method": "GET", "url": "{{baseUrl}}/quickcart/categories/{{categoryId}}/products?sortBy=position&sortDir=asc&page=1&pageSize=12" }
                }
            ]
        },
        {
            "name": "Orders",
            "item": [
                {
                    "name": "Track guest order (anonymous)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n    \"orderNumber\": \"000000002\",\n    \"contact\": \"98200 12345\"\n}" },
                        "url": "{{baseUrl}}/quickcart/orders/track",
                        "description": "Order number + checkout email or mobile number. 10 failed lookups per IP in 15 minutes -> HTTP 429."
                    }
                },
                {
                    "name": "My orders (customer)",
                    "request": {
                        "method": "GET",
                        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
                        "url": "{{baseUrl}}/quickcart/customers/me/orders?page=1&pageSize=10"
                    }
                },
                {
                    "name": "My order tracking (customer)",
                    "request": {
                        "method": "GET",
                        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
                        "url": "{{baseUrl}}/quickcart/customers/me/orders/{{orderNumber}}/tracking"
                    }
                },
                {
                    "name": "Sales stats (admin)",
                    "request": {
                        "method": "GET",
                        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
                        "url": "{{baseUrl}}/quickcart/orders/stats?from=&to=",
                        "description": "ACL QuickCart_CustomApi::order_stats. Defaults to the last 30 days; max 366 days."
                    }
                },
                {
                    "name": "Add tracking update (admin)",
                    "request": {
                        "method": "POST",
                        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\n    \"milestone\": \"shipped\",\n    \"title\": \"Handed over to Delhivery\",\n    \"comment\": \"Tracking number DL123456789IN\",\n    \"location\": \"Bengaluru hub\",\n    \"visibleToCustomer\": true,\n    \"updateStatus\": true\n}" },
                        "url": "{{baseUrl}}/quickcart/orders/{{orderId}}/tracking",
                        "description": "ACL QuickCart_OrderTracking::tracking_save. updateStatus works for confirmed, packed, shipped and out_for_delivery on new / processing orders."
                    }
                }
            ]
        },
        {
            "name": "Customers",
            "item": [
                {
                    "name": "My profile (customer)",
                    "request": {
                        "method": "GET",
                        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
                        "url": "{{baseUrl}}/quickcart/customers/me"
                    }
                },
                {
                    "name": "Customer insights (admin)",
                    "request": {
                        "method": "GET",
                        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
                        "url": "{{baseUrl}}/quickcart/customers/{{customerId}}/profile",
                        "description": "ACL QuickCart_CustomApi::customer_profiles."
                    }
                }
            ]
        }
    ]
}
